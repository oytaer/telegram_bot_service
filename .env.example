HOST=0.0.0.0
PORT=8080

# saas | standalone
DEPLOY_MODE=saas
STANDALONE_TENANT_CODE=

# 平台库（总后台 + 代理商）
PLATFORM_DATABASE_URL=mysql://root:password@127.0.0.1:3306/tg_platform

# 租户库连接模板，{tenant_code} 会被替换
TENANT_DATABASE_URL_TEMPLATE=mysql://root:password@127.0.0.1:3306/tg_tenant_{tenant_code}

JWT_ADMIN_SECRET=change-me-admin-secret
JWT_AGENT_SECRET=change-me-agent-secret
JWT_TENANT_SECRET=change-me-tenant-secret
JWT_EXPIRE_HOURS=24

RUST_LOG=info
